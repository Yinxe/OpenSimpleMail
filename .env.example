# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-string-at-least-24-chars
PORT=4000
HOST=0.0.0.0

# SQLite file. Use an absolute path when running from a different directory.
DATABASE_PATH=data/open-simple-mail.db

# Browser origins allowed to call the API directly (comma separated).
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Set to false to hide the "Try demo" button.
DEMO_ENABLED=true

# Maximum total attachment size per outgoing message, in MB.
MAX_ATTACHMENT_MB=25

# Session lifetime in days.
SESSION_DAYS=30

# Only enable when the app is served over HTTPS.
COOKIE_SECURE=false

# Set to 1 when running behind exactly one reverse proxy (Nginx/Caddy/Traefik).
TRUST_PROXY=0
