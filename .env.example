# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-string-at-least-24-chars

# API port. The Docker image pins this to 4000 internally; compose overrides it.
PORT=4010
HOST=0.0.0.0

# Dev web port used by Vite (`npm run dev`). Not used by the Docker image.
WEB_PORT=5174

# SQLite file. Use an absolute path when running from a different directory.
DATABASE_PATH=data/open-simple-mail.db

# Browser origins allowed to call the API directly (comma separated).
WEB_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Initial default for a fresh database. After setup, manage this in Settings.
DEMO_ENABLED=true

# Maximum total attachment size per outgoing message, in MB. Also the size cap
# for a single uploaded file.
MAX_ATTACHMENT_MB=25

# Scratch directory for outgoing uploads and extracted attachments. Defaults to
# `attachments/` next to the SQLite file, which the Docker volume already covers.
# ATTACHMENT_DIR=/app/data/attachments

# Upper bound for the attachment cache on disk, in MB.
ATTACHMENT_CACHE_MB=256

# Session lifetime in days.
SESSION_DAYS=30

# Only enable when the app is served over HTTPS.
COOKIE_SECURE=false

# Set to 1 when running behind exactly one reverse proxy (Nginx/Caddy/Traefik).
TRUST_PROXY=0

# Optional emergency administrator recovery. Minimum 12 characters.
# Set it temporarily, restart, use "Forgot admin password?" on the login page,
# then remove it and restart again. Leave empty to disable the feature.
# ADMIN_RECOVERY_PASSWORD=

# Mail server hosts are checked for SSRF: accounts pointing at loopback, LAN,
# link-local or cloud-metadata addresses are rejected. Set this to true when
# your own IMAP/SMTP server lives on a private network.
ALLOW_PRIVATE_MAIL_HOSTS=false

# Hostnames that stay allowed even when private networks are blocked, comma
# separated, e.g. mail.home.arpa,192.168.1.20
# MAIL_HOST_ALLOWLIST=
